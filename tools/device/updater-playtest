#!/bin/sh

ROOT=/mnt/SDCARD/flipos-dev
LOG="$ROOT/logs/frontend.log"
PREV="$ROOT/logs/frontend.previous.log"
RAM_LOG=/tmp/flipos-frontend.log
SUPERVISOR="$ROOT/bin/flip-optimizer-supervisor"
RAM_STOCK_SAFE=/tmp/flipos-optimizer-stock-safe

# Optimizer safety must be decided before any SD-card write is attempted.
# The supervisor only reads durable trial state and enforces its decision with
# a RAM latch, so a read-only/corrupt FAT volume cannot bypass stock-safe boot.
SUPERVISOR_OUT=""
SUPERVISOR_RC=0

if [ -x "$SUPERVISOR" ]; then
    SUPERVISOR_OUT=$("$SUPERVISOR" boot-enforce 2>&1)
    SUPERVISOR_RC=$?
else
    SUPERVISOR_OUT="OPTIMIZER_SUPERVISOR: missing; forcing runtime stock-safe"
    SUPERVISOR_RC=1
fi

if [ "$SUPERVISOR_RC" -ne 0 ]; then
    printf 'stock-safe\n' > "$RAM_STOCK_SAFE"
fi

SD_WRITABLE=0
if awk '
    $2 == "/mnt/sdcard" && $4 ~ /(^|,)rw(,|$)/ { writable=1 }
    END { exit writable ? 0 : 1 }
' /proc/mounts 2>/dev/null; then
    SD_WRITABLE=1
fi

if [ "$SD_WRITABLE" -eq 1 ]; then
    mkdir -p "$ROOT/logs" "$ROOT/logs/playtest" "$ROOT/state"

    if [ -f "$LOG" ]; then
        bytes=$(wc -c < "$LOG" 2>/dev/null || echo 0)
        if [ "${bytes:-0}" -ge 5242880 ]; then
            rm -f "$PREV"
            mv "$LOG" "$PREV"
        fi
    fi

    LOG_TARGET="$LOG"
else
    LOG_TARGET="$RAM_LOG"
    : > "$LOG_TARGET"
fi

{
    echo "========================================"
    echo "FlipOS launcher starting: $(date)"
    echo "========================================"
    printf '%s\n' "$SUPERVISOR_OUT"
    if [ "$SD_WRITABLE" -ne 1 ]; then
        echo "OPTIMIZER_SUPERVISOR: SD read-only; durable settlement deferred"
    fi
} >> "$LOG_TARGET" 2>&1

if [ "$SD_WRITABLE" -eq 1 ]; then
    chmod 755 "$ROOT/bin/flip-frontend"
    chmod 755 "$ROOT/bin/flip-gb"
    [ ! -f "$ROOT/bin/flip-gba" ] || chmod 755 "$ROOT/bin/flip-gba"
    [ ! -f "$ROOT/bin/flip-perf-capture" ] || chmod 755 "$ROOT/bin/flip-perf-capture"
    [ ! -f "$ROOT/bin/flip-playtest-logger.sh" ] || chmod 755 "$ROOT/bin/flip-playtest-logger.sh"
    [ ! -f "$ROOT/bin/flip-optimizer-supervisor" ] || chmod 755 "$ROOT/bin/flip-optimizer-supervisor"
    [ ! -f "$ROOT/bin/flip-optimizer-deadman" ] || chmod 755 "$ROOT/bin/flip-optimizer-deadman"
    [ ! -f "$ROOT/bin/flip-optimizer-guard" ] || chmod 755 "$ROOT/bin/flip-optimizer-guard"
    [ ! -f "$ROOT/bin/flip-optimizer-calibration" ] || chmod 755 "$ROOT/bin/flip-optimizer-calibration"
    [ ! -f "$ROOT/bin/flip-optimizer-session" ] || chmod 755 "$ROOT/bin/flip-optimizer-session"
    [ ! -f "$ROOT/bin/flip-optimizer-progress" ] || chmod 755 "$ROOT/bin/flip-optimizer-progress"
fi

# Durable rollback bookkeeping is secondary to the RAM safety decision.
if [ "$SD_WRITABLE" -eq 1 ]; then
    if [ -x "$ROOT/bin/flip-optimizer-guard" ]; then
        if ! "$ROOT/bin/flip-optimizer-guard" boot-check >> "$LOG_TARGET" 2>&1; then
            echo "OPTIMIZER_GUARD: boot check failed; runtime stock-safe remains authoritative" >> "$LOG_TARGET"
            printf 'stock-safe\n' > "$RAM_STOCK_SAFE"
        fi
    fi

    if [ -x "$ROOT/bin/flip-optimizer-calibration" ] && \
       [ -f "$ROOT/state/optimizer/cpu-calibration" ]; then
        if ! "$ROOT/bin/flip-optimizer-calibration" recover-boot >> "$LOG_TARGET" 2>&1; then
            echo "OPTIMIZER_CALIBRATION: boot reconcile failed; calibration paused" >> "$LOG_TARGET"
            printf 'stock-safe\n' > "$RAM_STOCK_SAFE"
        fi
    fi

    # Re-evaluate after durable settlement. A rolled-back trial may now be
    # represented by stock_only=1 rather than an active trial marker.
    echo "OPTIMIZER_SUPERVISOR: post-settlement enforcement" >> "$LOG_TARGET"
    if ! "$SUPERVISOR" boot-enforce >> "$LOG_TARGET" 2>&1; then
        echo "OPTIMIZER_SUPERVISOR: post-settlement enforcement failed" >> "$LOG_TARGET"
        printf 'stock-safe\n' > "$RAM_STOCK_SAFE"
    fi
fi

optimizer_external_power_online() {
    USB_ONLINE=0
    AC_ONLINE=0
    [ ! -r /sys/class/power_supply/usb/online ] || USB_ONLINE=$(cat /sys/class/power_supply/usb/online 2>/dev/null || echo 0)
    [ ! -r /sys/class/power_supply/ac/online ] || AC_ONLINE=$(cat /sys/class/power_supply/ac/online 2>/dev/null || echo 0)
    [ "$USB_ONLINE" = "1" ] || [ "$AC_ONLINE" = "1" ]
}

optimizer_wait_external_power_online() {
    if optimizer_external_power_online; then
        return 0
    fi

    # USB power can briefly report offline during reboot before the gadget/
    # charger path has settled. Require a sustained 5-second absence before
    # interpreting this as the user's physical cancel gesture.
    POWER_WAIT=0
    while [ "$POWER_WAIT" -lt 5 ]; do
        sleep 1
        if optimizer_external_power_online; then
            echo "OPTIMIZER_UI: charger became visible after boot settle wait=${POWER_WAIT}s" >> "$LOG_TARGET"
            return 0
        fi
        POWER_WAIT=$((POWER_WAIT + 1))
    done

    return 1
}

# A UI-started optimization uses charger presence as a physical cancel switch.
# Restore the previous known-good optimizer snapshot only after all boot
# recovery/guard settlement has completed, never inside the dangerous window.
if [ "$SD_WRITABLE" -eq 1 ] && \
   [ -f "$ROOT/state/optimizer/ui-return" ] && \
   [ -x "$ROOT/bin/flip-optimizer-calibration" ] && \
   ! optimizer_wait_external_power_online; then
    echo "OPTIMIZER_UI: charger absent at boot; restoring previous snapshot" >> "$LOG_TARGET"

    if [ -x "$ROOT/bin/flip-optimizer-session" ]; then
        "$ROOT/bin/flip-optimizer-session" stop >> "$LOG_TARGET" 2>&1 || true
    fi

    if "$ROOT/bin/flip-optimizer-calibration" restore-snapshot >> "$LOG_TARGET" 2>&1; then
        rm -f "$ROOT/state/optimizer/ui-return"
        sync
        echo "OPTIMIZER_UI: previous optimizer state restored; normal frontend boot" >> "$LOG_TARGET"
    else
        echo "OPTIMIZER_UI: snapshot restore failed; keeping UI marker for inspection" >> "$LOG_TARGET"
        printf 'stock-safe\n' > "$RAM_STOCK_SAFE"
    fi
fi

RUNTIME_ACTIVE_MARKER="$ROOT/state/optimizer/runtime-profile-active"
RUNTIME_QUARANTINE_MARKER="$ROOT/state/optimizer/runtime-profile-quarantined"
VALIDATION_REQUEST="$ROOT/state/optimizer/validation-request"
VALIDATION_ACTIVE="$ROOT/state/optimizer/validation-active"
VALIDATION_RESULT="$ROOT/state/optimizer/validation-result"
VALIDATION_RETURN="$ROOT/state/optimizer/validation-return"

# The runtime voltage module disappears on reboot, so a surviving active marker
# means the previous gameplay session ended without a clean restore. Quarantine
# the published profile instead of automatically risking it again.
if [ "$SD_WRITABLE" -eq 1 ] && [ -f "$RUNTIME_ACTIVE_MARKER" ]; then
    mv -f "$RUNTIME_ACTIVE_MARKER" "$RUNTIME_QUARANTINE_MARKER"
    sync
    echo "OPTIMIZER_RUNTIME: stale active marker quarantined; gameplay will use stock voltages" >> "$LOG_TARGET"
fi

# A validator that reboots unexpectedly leaves both validation-active and the
# runtime active marker. The runtime marker above becomes quarantine; convert
# that combination into an explicit hard-recovery validation failure.
if [ "$SD_WRITABLE" -eq 1 ] && \
   [ -f "$VALIDATION_ACTIVE" ] && \
   [ -f "$RUNTIME_QUARANTINE_MARKER" ]; then
    CAL_EPOCH=$(sed -n 's/^calibrated_epoch=//p' "$VALIDATION_ACTIVE" 2>/dev/null | head -1)
    [ -n "$CAL_EPOCH" ] || CAL_EPOCH=0
    NOW_EPOCH=$(date +%s 2>/dev/null || echo 0)
    cat > "$VALIDATION_RESULT.tmp" <<EOF
version=1
status=failed-hard-recovery
calibrated_epoch=$CAL_EPOCH
tested_epoch=$NOW_EPOCH
tested_opps=0
seconds_per_opp=0
max_temp_mc=0
EOF
    mv -f "$VALIDATION_RESULT.tmp" "$VALIDATION_RESULT"
    rm -f "$VALIDATION_ACTIVE" "$VALIDATION_REQUEST"
    sync
    echo "OPTIMIZER_VALIDATION: hard recovery detected; profile quarantined" >> "$LOG_TARGET"
fi

# UI-requested profile validation runs before the interactive frontend so the
# existing storage-quiesce and watchdog safety model remains authoritative.
# A normal validation completion deliberately reboots and never returns here.
if [ "$SD_WRITABLE" -eq 1 ] && \
   [ -f "$VALIDATION_REQUEST" ] && \
   [ ! -f "$RUNTIME_QUARANTINE_MARKER" ] && \
   [ -x "$ROOT/bin/flip-optimizer-candidate" ]; then
    VALIDATION_PROGRESS_PID=""
    if [ -x "$ROOT/bin/flip-optimizer-validation-progress" ]; then
        "$ROOT/bin/flip-optimizer-validation-progress" >/dev/null 2>&1 &
        VALIDATION_PROGRESS_PID=$!
        echo "OPTIMIZER_VALIDATION: progress splash pid=$VALIDATION_PROGRESS_PID" >> "$LOG_TARGET"
    fi

    echo "OPTIMIZER_VALIDATION: launching profile stress validation" >> "$LOG_TARGET"
    if ! "$ROOT/bin/flip-optimizer-candidate" validate-profile 60 >> "$LOG_TARGET" 2>&1; then
        echo "OPTIMIZER_VALIDATION: validator returned without reboot" >> "$LOG_TARGET"
    fi

    if [ -n "$VALIDATION_PROGRESS_PID" ]; then
        kill "$VALIDATION_PROGRESS_PID" 2>/dev/null || true
        wait "$VALIDATION_PROGRESS_PID" 2>/dev/null || true
    fi
fi

OPTIMIZER_PROGRESS_PID=""
if [ "$SD_WRITABLE" -eq 1 ] && \
   [ -f "$ROOT/state/optimizer/ui-return" ] && \
   [ -x "$ROOT/bin/flip-optimizer-progress" ] && \
   [ -x "$ROOT/bin/flip-optimizer-session" ] && \
   "$ROOT/bin/flip-optimizer-session" status 2>/dev/null | grep -q '^session_present=1$'; then
    "$ROOT/bin/flip-optimizer-progress" >/dev/null 2>&1 &
    OPTIMIZER_PROGRESS_PID=$!
    echo "OPTIMIZER_UI: progress splash pid=$OPTIMIZER_PROGRESS_PID" >> "$LOG_TARGET"
fi

# An explicit optimizer session may continue only after boot recovery has
# completely settled and the second supervisor pass says runtime is safe.
# If inactive/paused/complete this returns normally and frontend boot proceeds.
# If active with work remaining it execs one bounded candidate; that candidate
# settles and reboots, so normal frontend startup is intentionally skipped.
if [ "$SD_WRITABLE" -eq 1 ] && \
   [ ! -e "$RAM_STOCK_SAFE" ] && \
   [ -x "$ROOT/bin/flip-optimizer-session" ]; then
    if ! "$ROOT/bin/flip-optimizer-session" boot-resume >> "$LOG_TARGET" 2>&1; then
        echo "OPTIMIZER_SESSION: boot resume failed; normal frontend boot continues" >> "$LOG_TARGET"
    elif [ -x "$ROOT/bin/flip-optimizer-calibration" ] && \
         "$ROOT/bin/flip-optimizer-session" status 2>/dev/null | grep -q '^session_present=0$' && \
         "$ROOT/bin/flip-optimizer-calibration" status 2>/dev/null | grep -q '^complete_opps=8$'; then
        if "$ROOT/bin/flip-optimizer-calibration" publish >> "$LOG_TARGET" 2>&1; then
            "$ROOT/bin/flip-optimizer-calibration" discard-snapshot >> "$LOG_TARGET" 2>&1 || true
            rm -f "$ROOT/state/optimizer/runtime-profile-quarantined" "$ROOT/state/optimizer/runtime-profile-active" \
                "$ROOT/state/optimizer/validation-result" "$ROOT/state/optimizer/validation-active" \
                "$ROOT/state/optimizer/validation-request"
            sync
            echo "OPTIMIZER_SESSION: completed profile published; previous snapshot discarded; runtime quarantine cleared" >> "$LOG_TARGET"
        else
            echo "OPTIMIZER_SESSION: completed profile publish failed" >> "$LOG_TARGET"
        fi
    fi
fi

if [ -n "$OPTIMIZER_PROGRESS_PID" ]; then
    kill "$OPTIMIZER_PROGRESS_PID" 2>/dev/null || true
    wait "$OPTIMIZER_PROGRESS_PID" 2>/dev/null || true
    OPTIMIZER_PROGRESS_PID=""
fi

if [ "$SD_WRITABLE" -eq 1 ] && \
   [ -x "$ROOT/bin/flip-playtest-logger.sh" ] && \
   [ -x "$ROOT/bin/flip-perf-capture" ]; then
    "$ROOT/bin/flip-playtest-logger.sh"
fi

"$ROOT/bin/flip-frontend" >> "$LOG_TARGET" 2>&1
rc=$?

echo "FlipOS exited rc=$rc: $(date)" >> "$LOG_TARGET" 2>&1
[ "$SD_WRITABLE" -ne 1 ] || sync

exec /usr/miyoo/bin/runmiyoo-original.sh
