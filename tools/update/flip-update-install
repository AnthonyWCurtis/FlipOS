#!/bin/sh
set -eu

PACKAGE=${1:-/mnt/SDCARD/FlipOSUpdate}
ROOT=${FLIP_UPDATE_ROOT:-/mnt/SDCARD/flipos-dev}
META="$PACKAGE/manifest"
SUMS="$PACKAGE/SHA256SUMS"
PAYLOAD="$PACKAGE/payload"
STATE="$ROOT/state/update"
AVAILABLE="$STATE/available"
ONLINE_AVAILABLE="$STATE/online-available"
LOCK="$STATE/lock"
STAGE="$ROOT/.update-stage"
ROLLBACK="$ROOT/.update-rollback/current"
BOOT_UPDATER=/mnt/SDCARD/.tmp_update/updater
PROGRESS=${FLIP_UPDATE_PROGRESS:-/tmp/flipos-update-progress}

progress() {
    phase=$1
    percent=$2
    message=$3
    tmp="${PROGRESS}.tmp"
    {
        echo "phase=$phase"
        echo "percent=$percent"
        echo "message=$message"
    } > "$tmp"
    mv -f "$tmp" "$PROGRESS"
}

fail() {
    reason=$1
    progress failed 0 "$reason"
    echo "FLIP_UPDATE: $reason" >&2
    exit 1
}

cleanup() {
    rm -rf "$STAGE" 2>/dev/null || true
    rmdir "$LOCK" 2>/dev/null || true
}

rollback_install() {
    progress rollback 90 "RESTORING PREVIOUS VERSION"
    if [ -f "$ROLLBACK/installed.list" ]; then
        while IFS= read -r rel; do
            [ -n "$rel" ] || continue
            dest="$ROOT/$rel"
            backup="$ROLLBACK/files/$rel"
            if [ -f "$backup" ]; then
                mkdir -p "$(dirname "$dest")"
                cp "$backup" "${dest}.rollback"
                mv -f "${dest}.rollback" "$dest"
            else
                rm -f "$dest"
            fi
        done < "$ROLLBACK/installed.list"

        if [ -f "$ROLLBACK/boot-updater" ]; then
            mkdir -p "$(dirname "$BOOT_UPDATER")"
            cp "$ROLLBACK/boot-updater" "$BOOT_UPDATER.rollback"
            chmod 755 "$BOOT_UPDATER.rollback" || true
            mv -f "$BOOT_UPDATER.rollback" "$BOOT_UPDATER"
        elif [ -f "$ROLLBACK/boot-updater.missing" ]; then
            rm -f "$BOOT_UPDATER"
        fi
        sync
    fi
}

trap 'cleanup' EXIT HUP INT TERM

[ -d "$PACKAGE" ] || fail "UPDATE PACKAGE NOT FOUND"
[ -f "$META" ] || fail "UPDATE MANIFEST MISSING"
[ -f "$SUMS" ] || fail "UPDATE CHECKSUMS MISSING"
[ -d "$PAYLOAD" ] || fail "UPDATE PAYLOAD MISSING"

format=$(sed -n 's/^format=//p' "$META" | head -n 1)
target=$(sed -n 's/^target=//p' "$META" | head -n 1)
version=$(sed -n 's/^version=//p' "$META" | head -n 1)
build_id=$(sed -n 's/^build_id=//p' "$META" | head -n 1)

[ "$format" = "1" ] || fail "UNSUPPORTED UPDATE FORMAT"
[ "$target" = "miyoo-flip-rk3566" ] || fail "UPDATE IS FOR ANOTHER DEVICE"
[ -n "$version" ] || fail "UPDATE VERSION MISSING"
[ -n "$build_id" ] || fail "UPDATE BUILD ID MISSING"

mkdir -p "$STATE"
if ! mkdir "$LOCK" 2>/dev/null; then
    fail "ANOTHER UPDATE IS ALREADY RUNNING"
fi

progress validate 5 "CHECKING UPDATE PACKAGE"

FILES="$STATE/files.$$"
: > "$FILES"
count=0
while IFS= read -r line; do
    [ -n "$line" ] || continue
    case "$line" in
        [0-9a-fA-F]*'  '*) ;;
        *) rm -f "$FILES"; fail "INVALID CHECKSUM MANIFEST" ;;
    esac
    rel=${line#*  }
    case "$rel" in
        /*|*'..'*|*'//'*) rm -f "$FILES"; fail "UNSAFE UPDATE PATH" ;;
        bin/*|lib/*.ko|etc/umtprd.conf|licenses/*|updater-playtest|VERSION) ;;
        *) rm -f "$FILES"; fail "UPDATE CONTAINS DISALLOWED FILE" ;;
    esac
    [ -f "$PAYLOAD/$rel" ] || { rm -f "$FILES"; fail "UPDATE FILE MISSING"; }
    [ ! -L "$PAYLOAD/$rel" ] || { rm -f "$FILES"; fail "SYMLINKS ARE NOT ALLOWED"; }
    printf '%s\n' "$rel" >> "$FILES"
    count=$((count + 1))
    [ "$count" -le 128 ] || { rm -f "$FILES"; fail "UPDATE HAS TOO MANY FILES"; }
done < "$SUMS"

[ "$count" -gt 0 ] || { rm -f "$FILES"; fail "UPDATE PAYLOAD IS EMPTY"; }

(
    cd "$PAYLOAD"
    sha256sum -c "$SUMS"
) >/dev/null 2>&1 || { rm -f "$FILES"; fail "UPDATE CHECKSUM FAILED"; }

progress stage 20 "STAGING UPDATE"
rm -rf "$STAGE"
mkdir -p "$STAGE"
while IFS= read -r rel; do
    mkdir -p "$STAGE/$(dirname "$rel")"
    cp "$PAYLOAD/$rel" "$STAGE/$rel"
done < "$FILES"

# Verify the staged bytes too. This catches copy/media errors before installation.
while IFS= read -r line; do
    rel=${line#*  }
    expected=${line%%  *}
    actual=$(sha256sum "$STAGE/$rel" | awk '{print $1}')
    [ "$expected" = "$actual" ] || { rm -f "$FILES"; fail "STAGED UPDATE CHECKSUM FAILED"; }
done < "$SUMS"

progress backup 40 "PREPARING ROLLBACK"
rm -rf "$ROLLBACK"
mkdir -p "$ROLLBACK/files"
cp "$META" "$ROLLBACK/manifest.new"
: > "$ROLLBACK/installed.list"

if [ -f "$BOOT_UPDATER" ]; then
    cp "$BOOT_UPDATER" "$ROLLBACK/boot-updater"
else
    : > "$ROLLBACK/boot-updater.missing"
fi

while IFS= read -r rel; do
    dest="$ROOT/$rel"
    if [ -f "$dest" ]; then
        mkdir -p "$ROLLBACK/files/$(dirname "$rel")"
        cp "$dest" "$ROLLBACK/files/$rel"
    fi
done < "$FILES"
sync

progress install 60 "INSTALLING UPDATE"
installed=0
while IFS= read -r rel; do
    dest="$ROOT/$rel"
    mkdir -p "$(dirname "$dest")"
    if ! cp "$STAGE/$rel" "${dest}.new"; then
        rollback_install
        rm -f "$FILES"
        fail "UPDATE COPY FAILED"
    fi

    case "$rel" in
        bin/*|updater-playtest) chmod 755 "${dest}.new" || true ;;
        lib/*.ko|etc/umtprd.conf|licenses/*|VERSION) chmod 644 "${dest}.new" || true ;;
    esac

    if ! mv -f "${dest}.new" "$dest"; then
        rm -f "${dest}.new"
        rollback_install
        rm -f "$FILES"
        fail "UPDATE INSTALL FAILED"
    fi

    printf '%s\n' "$rel" >> "$ROLLBACK/installed.list"
    installed=$((installed + 1))
    percent=$((60 + (installed * 25 / count)))
    progress install "$percent" "INSTALLING UPDATE"
done < "$FILES"

sync

# Keep the SD boot hook in lockstep with the installed runtime. The package
# installs updater-playtest under the FlipOS root first so this copy is taken
# only after the validated runtime payload has landed.
if [ -f "$ROOT/updater-playtest" ]; then
    mkdir -p "$(dirname "$BOOT_UPDATER")"
    if ! cp "$ROOT/updater-playtest" "$BOOT_UPDATER.new"; then
        rollback_install
        rm -f "$FILES"
        fail "BOOT UPDATER INSTALL FAILED"
    fi
    chmod 755 "$BOOT_UPDATER.new" || true
    if ! mv -f "$BOOT_UPDATER.new" "$BOOT_UPDATER"; then
        rm -f "$BOOT_UPDATER.new"
        rollback_install
        rm -f "$FILES"
        fail "BOOT UPDATER INSTALL FAILED"
    fi
    sync
fi

progress commit 90 "FINALIZING UPDATE"
cat > "$STATE/last-good.tmp" <<EOF
format=1
target=$target
version=$version
build_id=$build_id
EOF
mv -f "$STATE/last-good.tmp" "$STATE/last-good"
mv -f "$ROLLBACK/manifest.new" "$ROLLBACK/installed-manifest"
rm -f "$AVAILABLE" "$ONLINE_AVAILABLE"
sync

rm -f "$FILES"
progress complete 100 "UPDATE COMPLETE - RESTART TO FINISH"
echo "FLIP_UPDATE_OK version=$version build_id=$build_id"
exit 0
