#!/bin/sh
set -eu

ROOT=${FLIP_UPDATE_ROOT:-/mnt/SDCARD/flipos-dev}
DEST=${FLIP_UPDATE_DEST:-/mnt/SDCARD/FlipOSUpdate}
STATE="$ROOT/state/update"
AVAILABLE="$STATE/available"
ONLINE_AVAILABLE="$STATE/online-available"
INSTALLED_VERSION="$ROOT/VERSION"
CHECK_ONLY=0

case "${1:-}" in
    "") ;;
    --check-only) CHECK_ONLY=1 ;;
    *)
        echo "usage: $0 [--check-only]" >&2
        exit 2
        ;;
esac

if [ "$CHECK_ONLY" -eq 1 ]; then
    WORK="$STATE/check"
else
    WORK="$STATE/download"
fi

PROGRESS=${FLIP_UPDATE_PROGRESS:-/tmp/flipos-update-progress}
API_URL=${FLIP_UPDATE_API_URL:-https://api.github.com/repos/AnthonyWCurtis/FlipOS/releases?per_page=10}
ASSET_NAME=${FLIP_UPDATE_ASSET_NAME:-FlipOS-Update.tar.gz}
MAX_ARCHIVE_BYTES=67108864
MAX_TAR_BYTES=134217728
case "$ASSET_NAME" in
    *[!A-Za-z0-9._-]*|*..*|"") echo "invalid update asset name" >&2; exit 1 ;;
esac

progress() {
    if [ "$CHECK_ONLY" -eq 1 ]; then
        return 0
    fi

    phase=$1
    percent=$2
    message=$3
    tmp="${PROGRESS}.tmp"
    {
        echo "phase=$phase"
        echo "percent=$percent"
        echo "message=$message"
    } > "$tmp"
    mv -f "$tmp" "$PROGRESS"
}

fail() {
    progress failed 0 "$1"
    echo "FLIP_UPDATE_FETCH: $1" >&2
    cleanup
    exit 1
}

cleanup() {
    rm -rf "$WORK" 2>/dev/null || true
}
# BusyBox ash can inherit EXIT traps inside command substitutions. That made
# the HTTP status command substitution remove $WORK before the archive download.
# Clean up explicitly instead, and reserve traps for actual interruption.
trap 'cleanup; exit 1' HUP INT TERM

mkdir -p "$STATE"
rm -rf "$WORK"
mkdir -p "$WORK/extract"

progress check 5 "CHECKING GITHUB FOR UPDATES"

RELEASES="$WORK/releases.json"
HTTP_CODE=$(curl -sS -L --connect-timeout 10 --max-time 30 \
        -H 'Accept: application/vnd.github+json' \
        -H 'User-Agent: FlipOS-Updater' \
        -o "$RELEASES" -w '%{http_code}' "$API_URL" 2>/dev/null) || \
    fail "COULD NOT REACH GITHUB"
case "$HTTP_CODE" in
    200) ;;
    404) fail "FLIPOS RELEASES ARE NOT PUBLIC YET" ;;
    403) fail "GITHUB UPDATE CHECK WAS REFUSED" ;;
    *) fail "GITHUB UPDATE CHECK FAILED" ;;
esac

# GitHub's releases list includes prereleases but excludes drafts for anonymous
# callers. Pick the first matching release asset, which gives Beta builds the
# same update path as stable releases.
# GitHub returns compact JSON, often as one very long line. Split fields on
# commas before extracting URLs/tags so greedy sed matching cannot accidentally
# select a later sidecar asset such as FlipOSUpdate.tar.gz.sha256.
ASSET_URL=$(tr ',' '\n' < "$RELEASES" \
    | grep '"browser_download_url"' \
    | sed 's/.*"browser_download_url"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/' \
    | grep "/$ASSET_NAME$" \
    | head -n 1)
TAG=$(tr ',' '\n' < "$RELEASES" \
    | grep '"tag_name"' \
    | head -n 1 \
    | sed 's/.*"tag_name"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/')

[ -n "$ASSET_URL" ] || fail "NO FLIPOS UPDATE ASSET FOUND"

installed_version=""
if [ -f "$INSTALLED_VERSION" ]; then
    installed_version=$(head -n 1 "$INSTALLED_VERSION" | tr -d '\r\n')
fi
release_version=${TAG#v}

if [ -n "$installed_version" ] &&
   [ -n "$release_version" ] &&
   [ "$release_version" = "$installed_version" ]; then
    rm -f "$ONLINE_AVAILABLE"
    if [ "$CHECK_ONLY" -eq 0 ]; then
        rm -f "$AVAILABLE"
        progress ready 100 "YOU'RE ON THE LATEST RELEASE"
    fi
    echo "FLIP_UPDATE_FETCH_LATEST version=$installed_version tag=${TAG:-unknown} check_only=$CHECK_ONLY"
    cleanup
    exit 0
fi

if [ "$CHECK_ONLY" -eq 1 ]; then
    printf '%s\n' "$release_version" > "${ONLINE_AVAILABLE}.tmp"
    mv -f "${ONLINE_AVAILABLE}.tmp" "$ONLINE_AVAILABLE"
    echo "FLIP_UPDATE_CHECK_AVAILABLE version=$release_version tag=${TAG:-unknown}"
    cleanup
    exit 0
fi

# Keep the lightweight availability marker after a full fetch too. If the
# user later deletes the downloaded package, System Update can still say that
# a release exists online without another network request.
printf '%s\n' "$release_version" > "${ONLINE_AVAILABLE}.tmp"
mv -f "${ONLINE_AVAILABLE}.tmp" "$ONLINE_AVAILABLE"

progress download 15 "DOWNLOADING UPDATE FROM GITHUB"
ARCHIVE="$WORK/$ASSET_NAME"
if ! curl -fL --connect-timeout 10 --max-time 300 \
        -H 'User-Agent: FlipOS-Updater' \
        "$ASSET_URL" -o "$ARCHIVE"; then
    fail "UPDATE DOWNLOAD FAILED"
fi

# Verify archive bytes against the GitHub release SHA-256 sidecar *before*
# any decompression or extraction. Sidecar hashing detects corruption and
# mismatched archives, but it does not prove publisher identity/signatures.
SIDECAR="$WORK/$ASSET_NAME.sha256"
if ! curl -fL --connect-timeout 10 --max-time 30 --max-filesize 4096 \
        -H 'User-Agent: FlipOS-Updater' \
        "$ASSET_URL.sha256" -o "$SIDECAR"; then
    fail "UPDATE CHECKSUM FILE MISSING"
fi
[ "$(wc -l < "$SIDECAR")" -eq 1 ] || fail "INVALID UPDATE CHECKSUM FILE"
set -f
set -- $(cat "$SIDECAR")
set +f
[ "$#" -eq 2 ] || fail "INVALID UPDATE CHECKSUM FILE"
expected_hash=$1
expected_name=${2##*/}
[ "$expected_name" = "$ASSET_NAME" ] || fail "UPDATE CHECKSUM FILE MISMATCH"
[ "${#expected_hash}" -eq 64 ] || fail "INVALID UPDATE CHECKSUM FILE"
case "$expected_hash" in *[!0-9a-fA-F]*) fail "INVALID UPDATE CHECKSUM FILE" ;; esac
[ "$(wc -c < "$ARCHIVE")" -le "$MAX_ARCHIVE_BYTES" ] ||
    fail "UPDATE ARCHIVE TOO LARGE"
actual_hash=$(sha256sum "$ARCHIVE" | awk '{print $1}')
[ "$(printf '%s' "$expected_hash" | tr 'A-F' 'a-f')" = "$actual_hash" ] ||
    fail "UPDATE ARCHIVE CHECKSUM FAILED"

# The stock Miyoo environment provides BusyBox ash, gzip, dd, od and awk.
# The file-size limit prevents compression bombs filling the SD card.
TARFILE="$WORK/update.tar"
if ! (ulimit -f 262144; gzip -dc "$ARCHIVE" > "$TARFILE") 2>/dev/null; then
    fail "INVALID OR OVERSIZED UPDATE ARCHIVE"
fi
tar_bytes=$(wc -c < "$TARFILE")
[ "$tar_bytes" -ge 1024 ] && [ "$tar_bytes" -le "$MAX_TAR_BYTES" ] ||
    fail "INVALID OR OVERSIZED UPDATE ARCHIVE"
[ $((tar_bytes % 512)) -eq 0 ] || fail "INVALID UPDATE TAR ALIGNMENT"

# Read and validate the original 512-byte TAR headers without extracting
# any entry. Only short ASCII USTAR/GNU-style names are used by the official
# FlipOS package builder. Reject PAX/GNU extensions, links, device nodes,
# malformed checksums, traversal, duplicate names and unknown payload paths.
tar_header() {
    dd if="$TARFILE" bs=512 skip="$1" count=1 2>/dev/null |
    od -An -v -t u1 |
    awk '
        function octal(first, count, i, x, seen, ended, value) {
            value=0; seen=0; ended=0
            for (i=first; i<first+count; ++i) {
                x=b[i]
                if (x==0 || x==32) {
                    if (seen) ended=1
                    continue
                }
                if (ended || x<48 || x>55) { bad=1; return 0 }
                seen=1; value=value*8+x-48
            }
            if (!seen) bad=1
            return value
        }
        { for (i=1; i<=NF; ++i) b[++n]=$i }
        END {
            if (n!=512) exit 1
            nonzero=0
            for (i=1; i<=512; ++i) if (b[i]!=0) nonzero=1
            if (!nonzero) { print "Z 0 EMPTY"; exit 0 }
            sum=0
            for (i=1; i<=512; ++i)
                sum+= (i>=149 && i<=156) ? 32 : b[i]
            stored=octal(149,8)
            size=octal(125,12)
            if (bad || sum!=stored || size<0) exit 1
            if (b[258]!=117 || b[259]!=115 || b[260]!=116 ||
                b[261]!=97 || b[262]!=114 ||
                (b[263]!=0 && b[263]!=32)) exit 1
            # USTAR prefix and linkname are not used by FlipOS packages.
            for (i=158; i<=257; ++i) if (b[i]!=0) exit 1
            for (i=346; i<=500; ++i) if (b[i]!=0) exit 1
            name=""
            for (i=1; i<=100 && b[i]!=0; ++i) {
                if (b[i]<33 || b[i]>126) exit 1
                name=name sprintf("%c",b[i])
            }
            if (name !~ /^FlipOSUpdate\// || name ~ /\.\./ ||
                name ~ /\/\// || name ~ /[^A-Za-z0-9._\/-]/) exit 1
            t=b[157]
            if (t==53) {
                if (size!=0 || name !~ /\/$/) exit 1
                if (name!="FlipOSUpdate/" &&
                    name!="FlipOSUpdate/payload/" &&
                    name!="FlipOSUpdate/payload/bin/" &&
                    name!="FlipOSUpdate/payload/lib/" &&
                    name!="FlipOSUpdate/payload/etc/" &&
                    name!="FlipOSUpdate/payload/licenses/") exit 1
                print "D 0 " name
            } else if (t==0 || t==48) {
                if (size>33554432 || name ~ /\/$/) exit 1
                if (name!="FlipOSUpdate/manifest" &&
                    name!="FlipOSUpdate/SHA256SUMS" &&
                    name!="FlipOSUpdate/payload/VERSION" &&
                    name!="FlipOSUpdate/payload/updater-playtest" &&
                    name !~ /^FlipOSUpdate\/payload\/bin\/[A-Za-z0-9._-]+$/ &&
                    name !~ /^FlipOSUpdate\/payload\/lib\/[A-Za-z0-9._-]+\.ko$/ &&
                    name!="FlipOSUpdate/payload/etc/umtprd.conf" &&
                    name !~ /^FlipOSUpdate\/payload\/licenses\/[A-Za-z0-9._-]+$/)
                    exit 1
                print "F " size " " name
            } else exit 1
        }'
}

progress verify 40 "CHECKING UPDATE ARCHIVE STRUCTURE"
total_blocks=$((tar_bytes / 512))
block=0
entry_count=0
payload_count=0
found_manifest=0
found_sums=0
seen="$WORK/seen-entries"
: > "$seen"
while [ "$block" -lt "$total_blocks" ]; do
    entry=$(tar_header "$block") || fail "UNSAFE UPDATE ARCHIVE HEADER"
    set -- $entry
    kind=$1
    size=$2
    name=$3
    if [ "$kind" = Z ]; then
        # GNU tar pads to a 20-block record. Require all remaining data zero.
        [ $((total_blocks - block)) -ge 2 ] &&
        [ $((total_blocks - block)) -le 20 ] ||
            fail "UNSAFE UPDATE ARCHIVE TRAILER"
        if ! dd if="$TARFILE" bs=512 skip="$block" 2>/dev/null |
                od -An -v -t u1 |
                awk '{ n+=NF; for (i=1; i<=NF; ++i) if ($i!=0) bad=1 }
                     END { if (bad || n<1024) exit 1 }'; then
            fail "UNSAFE UPDATE ARCHIVE TRAILER"
        fi
        break
    fi
    grep -Fqx "$name" "$seen" && fail "DUPLICATE UPDATE ARCHIVE ENTRY"
    printf '%s\n' "$name" >> "$seen"
    entry_count=$((entry_count+1))
    [ "$entry_count" -le 160 ] || fail "UPDATE ARCHIVE HAS TOO MANY ENTRIES"
    if [ "$kind" = F ]; then
        case "$name" in
            FlipOSUpdate/manifest) found_manifest=1 ;;
            FlipOSUpdate/SHA256SUMS) found_sums=1 ;;
            FlipOSUpdate/payload/*) payload_count=$((payload_count+1)) ;;
        esac
    fi
    block=$((block + 1 + (size + 511) / 512))
    [ "$block" -lt "$total_blocks" ] || fail "TRUNCATED UPDATE ARCHIVE"
done
[ "$found_manifest" -eq 1 ] && [ "$found_sums" -eq 1 ] &&
    [ "$payload_count" -gt 0 ] ||
    fail "INCOMPLETE UPDATE ARCHIVE"


progress unpack 55 "UNPACKING UPDATE"
if ! tar -xf "$TARFILE" -C "$WORK/extract"; then
    fail "UPDATE ARCHIVE IS INVALID"
fi

PACKAGE="$WORK/extract/FlipOSUpdate"
[ -d "$PACKAGE" ] || fail "UPDATE PACKAGE MISSING"
[ -f "$PACKAGE/manifest" ] || fail "UPDATE MANIFEST MISSING"
[ -f "$PACKAGE/SHA256SUMS" ] || fail "UPDATE CHECKSUMS MISSING"
[ -d "$PACKAGE/payload" ] || fail "UPDATE PAYLOAD MISSING"

format=$(sed -n 's/^format=//p' "$PACKAGE/manifest" | head -n 1)
target=$(sed -n 's/^target=//p' "$PACKAGE/manifest" | head -n 1)
version=$(sed -n 's/^version=//p' "$PACKAGE/manifest" | head -n 1)

[ "$format" = "1" ] || fail "UNSUPPORTED UPDATE FORMAT"
[ "$target" = "miyoo-flip-rk3566" ] || fail "UPDATE IS FOR ANOTHER DEVICE"
[ -n "$version" ] || fail "UPDATE VERSION MISSING"

progress verify 70 "VERIFYING DOWNLOADED UPDATE"
(
    cd "$PACKAGE/payload"
    sha256sum -c "$PACKAGE/SHA256SUMS"
) >/dev/null 2>&1 || fail "DOWNLOADED UPDATE CHECKSUM FAILED"

progress ready 90 "PREPARING UPDATE"
rm -rf "${DEST}.new"
mkdir -p "${DEST}.new"
cp -R "$PACKAGE/." "${DEST}.new/"
sync
rm -rf "$DEST"
mv "${DEST}.new" "$DEST"
sync

if [ "$version" != "$installed_version" ]; then
    printf '%s\n' "$version" > "${AVAILABLE}.tmp"
    mv -f "${AVAILABLE}.tmp" "$AVAILABLE"
else
    rm -f "$AVAILABLE"
fi
sync

progress ready 100 "UPDATE READY TO INSTALL"
echo "FLIP_UPDATE_FETCH_OK version=$version tag=${TAG:-unknown}"
cleanup
exit 0
